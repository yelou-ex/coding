# ============================================================
#  coding/ 仓库的忽略规则
#  原则：只提交"源码 + 文档 + 参数"，不提交构建产物、IDE 配置、
#        压缩包与可由它们重新生成的东西。
# ============================================================

# ---- 构建产物 ----
out/
classes/
target/
_build/
*.class

# ---- 产物 / 压缩包（目录里已有对应源码，重打即可）----
*.jar
*.zip

# ---- IDE ----
.idea/*
!.idea/modules.xml
!.idea/misc.xml
!.idea/encodings.xml
!.idea/compiler.xml
*.iml
!rgsw-lab/*.iml
!lwe-java/*.iml
!rlwe-java/*.iml
!cape-fusepir-database-handoff/*.iml
.classpath
.project
*.swp

# ---- 派生数据（由 PDF 重新抽取即可）----
pdf-extract/out_*.txt

# ---- Python ----
__pycache__/
*.pyc

# ---- ???MPC4J / SEAL ?????????????????----
!lib/*.jar
!lib/deps/*.jar
