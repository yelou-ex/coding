<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.fusepir</groupId>
    <artifactId>rgsw-lab</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>CAPE RGSW / blind rotation / Pack / Bloom scoring</name>
    <description>CAPE 论文同态加密部分：RGSW、盲旋转、Pack、Bloom 打分、四步端到端</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <!-- 依赖 jar 的位置：本模块的同级目录 lib/ -->
        <cape.lib>${project.basedir}/../lib</cape.lib>
    </properties>

    <!--
        ⚠️ 这个项目【必须用 JDK 25 运行】。

        lib/mpc4j-crypto-fhe-seal.jar 里的 class 文件是 major 69 = JDK 25。
        用 JDK 24 及以下会报「类文件版本 69 应为 68」，读不了。
        本机 JDK 25 装在 D:\Java\jdk-25。

        源码级别写成 17 只是为了放宽语法要求，编译产物仍需 JDK 25 运行。
    -->

    <dependencies>
        <!-- MPC4J 的 SEAL Java 移植版（HE 主线唯一必需依赖） -->
        <dependency>
            <groupId>edu.alibaba.mpc4j</groupId>
            <artifactId>mpc4j-crypto-fhe-seal</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${cape.lib}/mpc4j-crypto-fhe-seal.jar</systemPath>
        </dependency>

        <!-- lib/deps 下的 11 个传递依赖（bcprov / guava / trove4j / zstd ...） -->
        <dependency>
            <groupId>cape.local</groupId><artifactId>bcprov-jdk18on</artifactId><version>1.78.1</version>
            <scope>system</scope><systemPath>${cape.lib}/deps/bcprov-jdk18on-1.78.1.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>cape.local</groupId><artifactId>big-math</artifactId><version>2.3.2</version>
            <scope>system</scope><systemPath>${cape.lib}/deps/big-math-2.3.2.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>cape.local</groupId><artifactId>commons-lang3</artifactId><version>3.9</version>
            <scope>system</scope><systemPath>${cape.lib}/deps/commons-lang3-3.9.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>cape.local</groupId><artifactId>commons-math3</artifactId><version>3.6.1</version>
            <scope>system</scope><systemPath>${cape.lib}/deps/commons-math3-3.6.1.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>cape.local</groupId><artifactId>failureaccess</artifactId><version>1.0.1</version>
            <scope>system</scope><systemPath>${cape.lib}/deps/failureaccess-1.0.1.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>cape.local</groupId><artifactId>guava</artifactId><version>32.1.3-jre</version>
            <scope>system</scope><systemPath>${cape.lib}/deps/guava-32.1.3-jre.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>cape.local</groupId><artifactId>hamcrest-core</artifactId><version>1.3</version>
            <scope>system</scope><systemPath>${cape.lib}/deps/hamcrest-core-1.3.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>cape.local</groupId><artifactId>reload4j</artifactId><version>1.2.22</version>
            <scope>system</scope><systemPath>${cape.lib}/deps/reload4j-1.2.22.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>cape.local</groupId><artifactId>slf4j-api</artifactId><version>2.0.13</version>
            <scope>system</scope><systemPath>${cape.lib}/deps/slf4j-api-2.0.13.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>cape.local</groupId><artifactId>trove4j</artifactId><version>3.0.3</version>
            <scope>system</scope><systemPath>${cape.lib}/deps/trove4j-3.0.3.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>cape.local</groupId><artifactId>zstd-jni</artifactId><version>1.5.5-11</version>
            <scope>system</scope><systemPath>${cape.lib}/deps/zstd-jni-1.5.5-11.jar</systemPath>
        </dependency>

        <!-- LWE 层：LweRlweConversion / RlweBench 等类要用 cape.he.* -->
        <dependency>
            <groupId>cape</groupId>
            <artifactId>lwe-java</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
        <!-- 自研 RLWE：Mpc4jRgsw / LabConfig / RgswOps 等需要它 -->
        <dependency>
            <groupId>com.fusepir</groupId>
            <artifactId>rlwe-java</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
    </dependencies>
</project>
